# Postgres
POSTGRES_USER=ucaboot
POSTGRES_PASSWORD=ucaboot
POSTGRES_DB=ucaboot
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# nginx: the only public entry point → http://localhost:$APP_PORT
APP_PORT=8080

# Internal service ports (not published; reached through nginx)
BACKEND_PORT=3000
AUTH_PORT=9999
FRONTEND_PORT=5173          # Vite dev server (dev only)

# Supabase Auth, local only (in the cloud Supabase provides these)
AUTH_DB_PASSWORD=auth-dev-password
AUTH_JWT_SECRET=dev-only-jwt-secret-do-not-use-in-production
# Local Auth doesn't check it, but the Supabase client requires one. In the cloud: the project's anon key.
SUPABASE_ANON_KEY=local-dev-anon-key

# Mailpit
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
