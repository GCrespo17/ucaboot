# Development: same routes, but the frontend is Vite's dev server (with HMR over WebSocket).
# Mounted over the production default.conf by docker-compose.override.yml.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen ${APP_PORT};

  include /etc/nginx/conf.d/routes/api.conf;

  location / {
    proxy_pass http://frontend:${FRONTEND_PORT};
  }
}
