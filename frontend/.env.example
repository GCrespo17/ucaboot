# Variables del frontend para un despliegue fuera de Docker Compose (p. ej. Vercel).
# En local no hace falta este archivo: docker compose pasa las variables desde el .env de la raíz.
# Vite incrusta los valores VITE_* en el build, así que son públicos: nunca pongas secretos aquí.

# URL pública del backend (Render). Sin definir = mismo origen (/api, /socket.io vía nginx).
VITE_API_URL=https://ucaboot-backend.example.com

# URL del proyecto de Supabase. Sin definir = mismo origen (contenedor de Auth local detrás de nginx).
VITE_SUPABASE_URL=https://your-project.supabase.co

# Clave anon (pública) del proyecto de Supabase. No es secreta, pero se obtiene del panel de Supabase.
VITE_SUPABASE_ANON_KEY=your-anon-key
